GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: where quote-request emails are delivered, if different from
# GMAIL_USER (which authenticates the send but doesn't have to receive it).
MAIL_TO=

# Optional: destination for the SISAMB scheduling form specifically.
# Falls back to MAIL_TO, then GMAIL_USER, when unset.
MAIL_TO_SISAMB=

# Optional: destination for the Gestão Una scheduling form specifically.
# Falls back to MAIL_TO, then GMAIL_USER, when unset.
MAIL_TO_GESTAO=
